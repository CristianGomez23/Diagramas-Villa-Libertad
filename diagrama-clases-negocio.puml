@startuml
title Villa Libertad - Diagrama de Clases del Negocio
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

' ═══════════════════════════════════════════════════════════════
' SHARED — Seguridad, Config y Excepciones
' ═══════════════════════════════════════════════════════════════

package "shared.security" #F2F3F4 {

  class SecurityConfig <<Configuration>> {
    - oAuth2SuccessHandler: CustomOAuth2SuccessHandler
    - jwtFilter: JwtAuthenticationFilter
    + filterChain(http: HttpSecurity): SecurityFilterChain
  }

  class JwtAuthenticationFilter <<Component>> {
    # doFilterInternal(req, res, chain): void
    # shouldNotFilter(req: HttpServletRequest): boolean
  }

  class CustomOAuth2SuccessHandler <<Component>> {
    - userService: UserService
    - roleService: RoleService
    - auditService: AuditService
    - frontendUrl: String
    + onAuthenticationSuccess(req, res, auth): void
  }
}

package "shared.utils" #F2F3F4 {
  class JwtUtil <<Utility>> {
    + {static} generateAccessToken(name, pic, email, roles): String
    + {static} generateRefreshToken(email, name, pic): String
    + {static} validateToken(token: String): boolean
    + {static} getClaimsFromToken(token: String): Claims
  }
}

package "shared.config" #F2F3F4 {
  class AsyncConfig <<Configuration>> {
    + notificationExecutor(): Executor
    + auditExecutor(): Executor
  }

  class WebConfig <<Configuration>> {
    - frontendUrl: String
    + corsConfigurer(): WebMvcConfigurer
  }

  class DatabaseSeeder <<Configuration>> {
    + seedRoles(roles, users): CommandLineRunner
    + seedHotel(hotels, rooms): CommandLineRunner
  }
}

package "shared.exceptions" #F2F3F4 {
  class GlobalExceptionHandler <<RestControllerAdvice>> {
    + handleNotFound(e: ResourceNotFoundException): ResponseEntity
    + handleBadRequest(e: BadRequestException): ResponseEntity
    + handleUnauthorized(e: UnauthorizedException): ResponseEntity
    + handleOptimisticLock(e: Exception): ResponseEntity
    + handlePessimisticLock(e: Exception): ResponseEntity
    + handleValidation(e: MethodArgumentNotValidException): ResponseEntity
    + handleGeneric(e: Exception): ResponseEntity
  }

  class BadRequestException {
    + BadRequestException(message: String)
  }

  class ResourceNotFoundException {
    + ResourceNotFoundException(message: String)
  }

  class UnauthorizedException {
    + UnauthorizedException(message: String)
  }
}

