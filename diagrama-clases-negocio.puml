    + findUpcomingCheckOutsToday(today: LocalDate): List<Reservation>
    + countCompletedCheckOutsToday(today: LocalDate): long
    + sumRevenueTodayByTimestamp(start: LocalDateTime, end: LocalDateTime): BigDecimal
    + countReservationsToday(today: LocalDate): long
    + countNewReservationsToday(start: LocalDateTime, end: LocalDateTime): long
  }

  interface DashboardRoomRepository {
    + findAllActive(): List<Room>
    + countByStatus(): List<Object[]>
    + countActive(): int
